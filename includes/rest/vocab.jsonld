  "@graph": [
    {
      "@id": "oes:status",
      "@type": "rdf:Property",
      "rdfs:label": "OES editorial status",
      "rdfs:comment": "Internal editorial workflow status of an OES post (e.g. draft, progress, published)."
    },
    {
      "@id": "oes:citations",
      "@type": "rdf:Property",
      "rdfs:label": "OES citations",
      "rdfs:comment": "All citations of an OES post object."
    },
    {
      "@id": "oes:externals",
      "@type": "rdf:Property",
      "rdfs:label": "OES externals",
      "rdfs:comment": "All external links of an OES post object."
    }
  ]
}