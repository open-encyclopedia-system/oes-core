{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "oes/author-byline",
  "version": "0.1.0",
  "title": "Author Byline",
  "category": "oes-schema",
  "description": "Displays the author(s) of the contribution, including sorting and an optional ORCID entry. The data source is defined in the OES schema settings.",
  "keywords": [
    "attribution",
    "credit",
    "author",
    "autor",
    "orcid",
    "contributor"
  ],
  "attributes": {
    "labels": {
      "type": "object"
    },
    "sorting": {
      "type": "boolean",
      "default": true
    },
    "orcid": {
      "type": "boolean"
    }
  },
  "styles": [
    {
      "name": "oes-default",
      "label": "Inline",
      "isDefault": true
    },
    {
      "name": "oes-list",
      "label": "List"
    }
  ],
  "supports": {
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "align": true,
    "anchor": true,
    "alignContent": true,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "alignText": true,
    "fullHeight": true
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}